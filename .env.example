FRAUD_DATABASE_URL=postgresql+psycopg://fraud:change_me@localhost:5432/fraud_detection
FRAUD_MODEL_DIR=./artifacts/models
FRAUD_DATASET_PATH=./data/raw/creditcard.csv
# Leave empty to use the validation-selected threshold from training metadata.
FRAUD_FRAUD_THRESHOLD=
FRAUD_HIGH_RISK_THRESHOLD=0.9
FRAUD_CORS_ORIGINS=http://localhost:5173
# Set a strong random value to enable POST /api/v1/model/retrain.
FRAUD_ADMIN_API_KEY=
FRAUD_MAX_UPLOAD_MB=10
